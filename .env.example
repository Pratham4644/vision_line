# ==============================================================================
# Remote Camera Streaming Platform - Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env AND POPULATE WITH REAL VALUES.
# NEVER COMMIT SECRETS OR PASSWORDS TO SOURCE CONTROL.

# Application Runtime
APP_ENV=development
APP_NAME="Remote Camera Streaming Platform"
DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000

# Database (MongoDB Atlas URI)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net"
MONGODB_DATABASE=camera_stream_platform

# Authentication (Must be >= 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Cookies
COOKIE_NAME=camera_session
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAMESITE=lax

# Camera Credential Encryption (Symmetric key, min 16 characters or 32-byte urlsafe base64)
CAMERA_ENCRYPTION_KEY=replace_with_a_secure_camera_encryption_key_32_bytes

# MediaMTX Streaming Integration
MEDIAMTX_HOST=127.0.0.1
MEDIAMTX_RTSP_PORT=8554
MEDIAMTX_WEBRTC_PORT=8889
MEDIAMTX_WEBRTC_PUBLIC_URL=https://camera1.koreacentral.cloudapp.azure.com
MEDIAMTX_API_URL=http://127.0.0.1:9997
MEDIAMTX_PUBLISH_USERNAME=edge_publisher
MEDIAMTX_PUBLISH_PASSWORD=replace_with_secure_publisher_password
MEDIAMTX_READ_USERNAME=webrtc_reader
MEDIAMTX_READ_PASSWORD=replace_with_secure_reader_password

# Recording Storage & Retention
RECORDINGS_DIR=recordings
RECORDING_SEGMENT_MINUTES=60
RECORDING_RETENTION_HOURS=2

# CORS Frontend Origin (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173